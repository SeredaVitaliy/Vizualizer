{
  "name": "design-studio",
  "productName": "Студия",
  "version": "1.1.0",
  "description": "Локальная студия обработки изображений: улучшение, фон, правка по описанию, проверка макетов, векторизация",
  "main": "main.js",
  "author": "Vitaliy",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64",
    "dist:setup": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@visioncortex/vtracer": "1.0.0-alpha.4",
    "adm-zip": "0.6.1",
    "onnxruntime-node": "1.30.0"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299"
  },
  "build": {
    "appId": "local.vitaliy.studio",
    "productName": "Studio",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "node_modules/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/@visioncortex/**",
      "lib/vtrace-worker.js",
      "renderer/vectorizer/vt-prep.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "signExecutable": false,
      "icon": "build/icon.png",
      "artifactName": "Studio-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Studio-${version}-setup.exe"
    }
  }
}
